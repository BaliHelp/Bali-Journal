# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Database connection for Prisma (Supabase - Transaction Pooler)
DATABASE_URL=

# Direct connection for migrations (Supabase - Session Pooler)
DIRECT_URL=

# Supabase public credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Authentication (NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=


# ==============================================================================
# MYAI OS GATEWAY (unified AI provider for all agents - Wie, Audy, As, Wue).
# OpenAI-compatible endpoint. Get your API key from https://console.myai.nexus
# Per-agent model routing lives in src/lib/ai/myaiClient.ts (MYAI_MODELS).
# ==============================================================================
MYAI_API_KEY=
MYAI_BASE_URL="https://console.myai.nexus/api/v1"
